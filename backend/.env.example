# QuoteTrack backend configuration.
# Copy to .env and adjust values as needed.

# PostgreSQL connection string (docker-compose default shown).
DATABASE_URL=postgres://quotetrack:quotetrack@localhost:5432/quotetrack

# Secret used to sign JWT access tokens. Use a long random value in production.
JWT_SECRET=change-me-to-a-long-random-string

# How long JWT access tokens stay valid (Go duration, default 168h = 7 days).
JWT_EXPIRY=168h

# Backend HTTP port.
PORT=8080

# Frontend origin allowed by CORS.
FRONTEND_ORIGIN=http://localhost:5173

# Frontend URL used to build password-reset links.
FRONTEND_URL=http://localhost:5173

# --- Email (SMTP) ---
# Leave SMTP_HOST empty to disable email delivery (dev mode).
# In dev mode, reset URLs are logged to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@quotetrack.com
